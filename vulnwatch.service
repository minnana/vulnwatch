[Unit]
Description=VulnWatch 漏洞情报监控
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vulnwatch
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
Environment=VULNWATCH_TIMEZONE=Asia/Shanghai
Environment=VULNWATCH_DAILY_HOUR=9
Environment=VULNWATCH_DAILY_MINUTE=0
# 可选:把 VULNWATCH_AUTH_TOKEN 等敏感配置放到 /opt/vulnwatch/.env
EnvironmentFile=-/opt/vulnwatch/.env
# 必须单进程(单 worker):APScheduler 与 SQLite 都在进程内
ExecStart=/opt/vulnwatch/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
