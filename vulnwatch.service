[Unit]
Description=VulnWatch 漏洞情报监控系统
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vulnwatch
Environment="VULNWATCH_DAILY_HOUR=9"
Environment="VULNWATCH_DAILY_MINUTE=0"
ExecStart=/opt/vulnwatch/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
