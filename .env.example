# VulnWatch 环境变量示例
# 用法:复制为 .env(不要提交到 git),docker compose 与 systemd 都会自动读取。
# 所有变量均为可选,留空即使用代码内置默认值。

# 访问口令:留空表示不鉴权(仅建议放在内网)。
# 设置后,浏览器首次访问用 http://<host>:8000/?token=<口令> 打开,
# 页面会把口令存入 localStorage 并从地址栏移除,之后所有数据接口自动带 Authorization 头。
VULNWATCH_AUTH_TOKEN=

# 时区(影响每日汇总时间、静默时段与展示时间)
TZ=Asia/Shanghai
VULNWATCH_TIMEZONE=Asia/Shanghai

# 数据目录(容器内默认 /app/data;非容器部署可改为 ./data 等)
VULNWATCH_DATA_DIR=/app/data

# 每日汇总时间:仅在数据库第一次初始化时作为 daily_time 的默认值,
# 之后请直接在网页「配置 → 定时任务」里修改(会立即生效,无需重启)。
VULNWATCH_DAILY_HOUR=9
VULNWATCH_DAILY_MINUTE=0
