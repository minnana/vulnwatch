# VulnWatch 环境变量示例
# 用法:复制为 .env(不要提交到 git)。systemd 读取全部变量；
# docker compose 只传入 docker-compose.yml 的 environment 中列出的变量。
# 未设置的变量使用默认值；不要把可选变量赋空值来代替删除。

# 访问口令:留空表示不鉴权；正式部署请设置随机口令。
# 设置后,浏览器首次访问用 http://<host>:8000/?token=<口令> 打开,
# 页面会把口令存入 localStorage 并从地址栏移除,之后所有数据接口自动带 Authorization 头。
VULNWATCH_AUTH_TOKEN=

# 时区(影响每日汇总时间、静默时段与展示时间)
TZ=Asia/Shanghai
VULNWATCH_TIMEZONE=Asia/Shanghai

# 数据目录: Docker 默认 /app/data，systemd 默认 /var/lib/vulnwatch。
# 保留部署方式的默认值；systemd 沙箱只允许写 /var/lib/vulnwatch。
# VULNWATCH_DATA_DIR=/var/lib/vulnwatch

# systemd 默认只监听本机；直接供局域网访问时填写服务器的内网 IP。
# Docker 的监听与映射由 Dockerfile / docker-compose.yml 管理。
# VULNWATCH_HOST=127.0.0.1

# 每日汇总时间:仅在数据库第一次初始化时作为 daily_time 的默认值,
# 之后请直接在网页「配置 → 定时任务」里修改(会立即生效,无需重启)。
VULNWATCH_DAILY_HOUR=9
VULNWATCH_DAILY_MINUTE=0
